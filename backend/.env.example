# Environment Variables for UPI FraudGuard AI Backend

# Database URL: defaults to SQLite for turnkey zero-configuration setup.
# To use PostgreSQL, configure: postgresql+psycopg2://postgres:password@localhost:5432/upi_fraud_db
DATABASE_URL=sqlite:///./fraud_guard.db

# Security & JWT Secrets
JWT_SECRET=super_secret_upi_fraud_guard_production_key_98437298
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ML Model path
MODEL_PATH=../ml_models/fraud_model.pkl

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Background Simulator Config
SIMULATOR_INTERVAL_SECONDS=3.0
SIMULATOR_DEFAULT_ACTIVE=true
